{
  "name": "@ai-chat/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts --adapters-env-file=src/adapters/.env",
    "build": "node build.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "lint-staged": {
    "*.ts": [
      "node ../../node_modules/eslint/bin/eslint.js --fix",
      "node ../../node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{js,mjs,json,css,scss,less,md,yml,yaml}": "node ../../node_modules/prettier/bin/prettier.cjs --write"
  },
  "dependencies": {
    "@ai-chat/contracts": "2.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4"
  }
}
