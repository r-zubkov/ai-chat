{
  "name": "@ai-chat/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/prepare-assets.mjs",
    "start": "ng serve -c local",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "ng build -c production",
    "lint": "eslint .",
    "typecheck": "ngc -p tsconfig.app.json && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "node ../../node_modules/eslint/bin/eslint.js --fix",
      "node ../../node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{js,mjs,json,css,scss,less,md,yml,yaml}": "node ../../node_modules/prettier/bin/prettier.cjs --write"
  },
  "dependencies": {
    "@ai-chat/contracts": "1.0.0",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@ngrx/signals": "^22.0.1",
    "@taiga-ui/cdk": "^5.31.0",
    "@taiga-ui/core": "^5.31.0",
    "@taiga-ui/event-plugins": "^5.1.0",
    "@taiga-ui/icons": "^5.31.0",
    "@taiga-ui/kit": "^5.31.0",
    "dexie": "^4.2.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0"
  }
}
