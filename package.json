{
  "name": "ai-chat",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run build -w @ai-chat/contracts && concurrently -k -n contracts,api,web -c yellow,cyan,green \"npm run dev -w @ai-chat/contracts\" \"npm run dev -w @ai-chat/api\" \"npm run start -w @ai-chat/web\"",
    "build": "npm run build -w @ai-chat/contracts && npm run build -w @ai-chat/web && npm run build -w @ai-chat/api && node scripts/assemble-dist.mjs",
    "preview": "node dist/server.mjs",
    "lint": "npm run lint -w @ai-chat/contracts && npm run lint -w @ai-chat/api && npm run lint -w @ai-chat/web",
    "typecheck": "npm run typecheck -w @ai-chat/contracts && npm run typecheck -w @ai-chat/api && npm run typecheck -w @ai-chat/web",
    "pretest": "npm run build -w @ai-chat/contracts",
    "test": "npm run test -w @ai-chat/contracts && npm run test -w @ai-chat/api && npm run test -w @ai-chat/web",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{js,mjs,json,css,scss,less,md,yml,yaml}": "node ./node_modules/prettier/bin/prettier.cjs --write"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^9.39.3",
    "@types/express": "^4.17.21",
    "@types/jasmine": "~5.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "angular-eslint": "^22.6.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "lint-staged": "16.2.7",
    "prettier": "^3.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.8"
  }
}
